# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
prisma/*
!prisma/seed.ts
!prisma/schema.prisma
!prisma/migrations/
!prisma/migrations/**

# uploads
/public/uploads/*
!/public/uploads/.gitkeep
/public/temp/*
!/public/temp/.gitkeep

# Storage (runtime files)
storage/**
!storage/.gitkeep
!storage/colissimo/
!storage/colissimo/.gitkeep
!storage/colissimo/labels/
!storage/colissimo/labels/.gitkeep

# --- OpenClaw GitHub backup safety rules ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
.htpasswd
.htdigest
*secret*.json
*credentials*.json

node_modules/
.next/
dist/
build/
out/
.cache/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

vendor/
cache/
logs/
tmp/
temp/
runtime/
protected/runtime/
uploads/
public/uploads/*
!public/uploads/.gitkeep
storage/**
!storage/.gitkeep
backups/
backup/
*.sql
# ...but always keep Prisma migration SQL: prod runs `prisma migrate deploy` from
# these committed files, so they must never be hidden by the global *.sql rule above.
!prisma/migrations/**/*.sql
*.dump
*.tar
*.tar.gz
*.zip
